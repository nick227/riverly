{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "ignoreExports": [
    // fastify-openapi-glue resolves handlers at runtime by operationId from
    // `import * as handlers` (apps/server/src/app.ts). Every export here is an
    // OpenAPI operation; apps/server/src/__tests__/handlers.test.ts pins the mapping.
    { "file": "apps/server/src/handlers/*.ts", "exports": ["*"] }
  ],
  "duplicates": {
    // Generated by openapi-typescript from packages/api-spec; never hand-edited.
    "ignore": ["packages/sdk/src/generated/**"]
  },
  // Root scripts/ (spec → tests/docs generators) are developer tooling run with the
  // root devDependencies and never ship; fallow counts them as production code. The
  // server declares js-yaml in its own dependencies, so the root devDependency is correct.
  "ignoreDependencies": ["js-yaml"]
}
