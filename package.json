{
  "name": "riverly",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm --filter './apps/*' build",
    "typecheck": "pnpm --recursive typecheck",
    "lint": "pnpm --recursive lint",
    "test": "pnpm --recursive test",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "factory:add": "tsx scripts/factory-add.ts",
    "sdk:generate": "pnpm --filter @project/sdk generate",
    "sdk:check": "tsx scripts/check-sdk-drift.ts",
    "spec:lint": "redocly lint packages/api-spec/openapi.yaml",
    "test:generate": "tsx scripts/generate-tests.ts",
    "docs:generate": "tsx scripts/generate-docs.ts",
    "pages:generate": "tsx scripts/generate-pages.ts",
    "db:local:start": "bash scripts/db-local.sh start",
    "db:local:stop": "bash scripts/db-local.sh stop",
    "db:local:status": "bash scripts/db-local.sh status",
    "db:migrate:dev": "pnpm --filter @project/db db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @project/db db:migrate:deploy",
    "db:migrate:status": "pnpm --filter @project/db db:migrate:status",
    "db:validate": "pnpm --filter @project/db db:validate",
    "db:seed": "pnpm --filter server seed",
    "db:seed:reset": "pnpm --filter server seed -- --reset",
    "db:studio": "pnpm --filter @project/db db:studio"
  },
  "devDependencies": {
    "@redocly/cli": "^2.62.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.5",
    "js-yaml": "^5.4.3",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  }
}
