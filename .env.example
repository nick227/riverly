# ── Database (MySQL 8) ───────────────────────────────────────────────
# Local: `pnpm db:local:start` or `docker compose up -d db`
# Railway: reference the MySQL service variable, e.g. DATABASE_URL=${{MySQL.MYSQL_URL}}
DATABASE_URL="mysql://riverly:riverly_dev@127.0.0.1:3407/riverly_dev"

# ── Server ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
# 32+ random characters in production: openssl rand -base64 48
SESSION_SECRET="dev-session-secret-change-me-0123456789"
# 32 random bytes, base64 — encrypts company email provider keys. Required in production.
# openssl rand -base64 32
ENCRYPTION_KEY=
# Comma-separated list of web app origins allowed to call the API with cookies
CORS_ORIGIN=http://localhost:5180
# Public URLs (used in invitation links and signed file URLs)
WEB_URL=http://localhost:5180
API_PUBLIC_URL=http://localhost:3001
# Company self-signup (licensed onboarding). Defaults to on outside production.
ALLOW_COMPANY_SIGNUP=
# Run the email outbox worker inside the API process (default true)
WORKER_ENABLED=
WORKER_POLL_MS=2000

# ── File storage ─────────────────────────────────────────────────────
# local = .data/uploads (development only). Production requires s3 (Railway bucket, R2, S3).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/uploads
UPLOAD_MAX_MB=25
# S3-compatible bucket. Railway buckets also expose BUCKET / ACCESS_KEY_ID / SECRET_ACCESS_KEY / ENDPOINT / REGION.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=

# ── Email ────────────────────────────────────────────────────────────
# Development transport writes to .data/outbox and simulates provider events. Off in production by default.
EMAIL_DEV_TRANSPORT=
DEV_OUTBOX_DIR=.data/outbox
# Optional platform-level Resend key (companies can also store their own, encrypted)
RESEND_API_KEY=
# Signing secret for the Resend webhook → POST /webhooks/email/resend
RESEND_WEBHOOK_SECRET=

# ── Web (Vite) ───────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001
