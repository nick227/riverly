{
  "name": "@project/db",
  "version": "0.0.1",
  "private": true,
  "main": "./src/client.ts",
  "exports": {
    ".": "./src/client.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "db:validate": "dotenv -e ../../.env -- prisma validate",
    "db:migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "db:migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:migrate:status": "dotenv -e ../../.env -- prisma migrate status",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "dotenv-cli": "^7.4.4"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "type": "module"
}
