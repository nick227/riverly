{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "worker": "tsx src/worker.ts",
    "test": "dotenv -e ../../.env.test -e ../../.env -- vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit -p tsconfig.json",
    "seed": "dotenv -e ../../.env -- tsx src/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.670.0",
    "@aws-sdk/s3-request-presigner": "^3.670.0",
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/static": "^7.0.4",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^4.1.0",
    "@project/db": "workspace:*",
    "@project/shared": "workspace:*",
    "bcryptjs": "^2.4.3",
    "csv-parse": "^5.5.6",
    "fastify": "^4.28.1",
    "fastify-openapi-glue": "^4.7.0",
    "js-yaml": "^4.1.0",
    "tsx": "^4.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.16.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "dotenv-cli": "^7.4.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "type": "module"
}
