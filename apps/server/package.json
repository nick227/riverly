{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "worker": "tsx src/worker.ts",
    "test": "dotenv -e ../../.env.test -e ../../.env -- vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit -p tsconfig.json",
    "seed": "dotenv -e ../../.env -- tsx src/seed/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.670.0",
    "@aws-sdk/s3-request-presigner": "^3.670.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.1.2",
    "@fastify/multipart": "^10.1.3",
    "@fastify/static": "^10.1.6",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@project/db": "workspace:*",
    "@project/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "csv-parse": "^7.0.3",
    "fastify": "^5.12.5",
    "fastify-openapi-glue": "^4.7.0",
    "js-yaml": "^5.4.3",
    "tsx": "^4.19.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.5",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "dotenv-cli": "^11.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "type": "module"
}
